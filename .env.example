# ==============================================================================
# ZCodeDev Metricool Studio - Environment Configuration
# ==============================================================================

# Core App Settings
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 1. Supabase Database & Auth (Phase 2)
# ------------------------------------------------------------------------------
# Required for persistent PostgreSQL database, auth, schedules, and audit logs.
# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser / client code!
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 2. Cloudflare R2 Storage (Phase 3)
# ------------------------------------------------------------------------------
# S3-compatible cloud storage for permanent video, processed video & thumbnails.
# Videos are NEVER stored directly in PostgreSQL.
# Direct browser-to-R2 uploads are performed using presigned URLs.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=zcodedev-metricool-videos
# Public or custom worker domain for reading / serving videos (e.g. https://media.zcodedev.com)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-your_r2_bucket.r2.dev

# ------------------------------------------------------------------------------
# 3. Postiz Publishing API & Webhooks (Phase 4 & 5)
# ------------------------------------------------------------------------------
# Official Postiz REST API credentials for multi-platform distribution.
# Must remain strictly SERVER-SIDE only. Never expose POSTIZ_API_KEY to frontend.
POSTIZ_API_URL=https://postiz.yourdomain.com/api/v1
POSTIZ_API_KEY=postiz_api_key_here
POSTIZ_WEBHOOK_SECRET=your_postiz_webhook_signing_secret_here

# ------------------------------------------------------------------------------
# 4. Cron & Automated Publishing Triggers
# ------------------------------------------------------------------------------
# Bearer secret for automated scheduler jobs (/api/cron).
# Supported via HTTP Header: Authorization: Bearer <CRON_SECRET>
# or Query Param: /api/cron?secret=<CRON_SECRET> (for external schedulers / Netlify functions)
CRON_SECRET=metricool_secure_cron_trigger_2026

# ------------------------------------------------------------------------------
# 5. Direct Social Media OAuth Fallback (Optional)
# ------------------------------------------------------------------------------
# Used when publishing directly without Postiz proxy.
# YouTube / Google Cloud
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta Graph API (Instagram & Facebook)
META_APP_ID=
META_APP_SECRET=

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Twitter / X API v2
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn Member API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
